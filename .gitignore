# Dissertation source and generated data
# Keep datasets outside Git; document how to obtain or regenerate them.
LiDAR_Years_All/
lidar_data_29jun/
data/raw/
data/interim/
data/processed/
!data/processed/README.md
data/new_data_22jul/

# Archived datasets are also local and too large for Git.
legacy/**/data/
legacy/**/*.gpkg

# Model outputs are regenerated by models/baselines/run_baselines.py and
# evaluate_baselines.py. Some (rf_baseline's model.joblib) can be hundreds of
# MB to over 1GB, well past GitHub's 100MB file limit -- not worth Git LFS
# for artifacts this cheap and fast to regenerate locally. See
# models/rf_baseline/rf_baseline.py's save_model() for details.
outputs/

# Cluster logs are generated. Keep only optional .gitkeep placeholders.
# Un-ignoring a directory (e.g. !logs/dnn_noenv/) only makes git look inside
# it -- it does NOT stop individual files inside from being tracked, so each
# subdirectory also needs its own "ignore everything, then un-ignore
# .gitkeep" pair; otherwise real .out/.err run logs get committed.
logs/*
!logs/baselines/
logs/baselines/*
!logs/baselines/.gitkeep
!logs/data_processing/
logs/data_processing/*
!logs/data_processing/.gitkeep
!logs/dnn_noenv/
logs/dnn_noenv/*
!logs/dnn_noenv/.gitkeep
!logs/pinn_noenv/
logs/pinn_noenv/*
!logs/pinn_noenv/.gitkeep
data_exploration_gpkg/notebooks/spatial_viz_comparison_scratch.ipynb
notebooks/scratch/spatial_viz_comparison_scratch.ipynb
